ot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="67"/><column index="2" value="86"/><column index="3" value="115"/><column index="4" value="222"/><column index="5" value="112"/><column index="6" value="83"/><column index="7" value="101"/><column index="8" value="123"/><column index="9" value="40"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Create new collumn and rename (merge)
-- lower = ตัวพิมใหญ่เปลี่ยนเป็นตัวพิมเล็ก Upper = เปลี่ยนเป็นตัวพิมใหญ่

SELECT 
        FirstName, 
		LastName, 
		FirstName || ' ' || LastName AS Fullname,
		lower (FirstName) || '@company.com ' AS Email ,
		upper (FirstName) || '@company.com ' AS Email 
 FROM  customers 
 LIMIT 10;





 

 
 
 
 </sql><sql name="SQL 3*">-- change ตัวเลขเป็นทศนิยม สองตำแหน่งด้วย

SELECT  
         name, 
          round  (Milliseconds/60000.0, 2)   AS minute, 
		  round  (Bytes /(1024*1024.0), 2)   AS mb
FROM tracks;</sql><current_tab id="1"/></tab_sql></sqlb_project>
